            window.print();
        }

        async function shareDirect(platform) {
            const canvasEl = document.getElementById('collage-canvas');
            try {
                const renderedCanvas = await html2canvas(canvasEl, { scale: 2 });
                renderedCanvas.toBlob(async (blob) => {
                    if (navigator.share && blob) {
                        const file = new File([blob], 'laporan-kolaj.png', { type: 'image/png' });
                        try {
                            await navigator.share({
                                title: 'Laporan Bergambar',
                                text: 'Lihat Laporan Bergambar Kolaj Saya:',
                                files: [file]
                            });
                            return;
                        } catch (e) {
                            console.log('Web Share dibatalkan', e);
                        }
                    }

                    const text = encodeURIComponent("Lihat Laporan Bergambar Kolaj Saya:");
