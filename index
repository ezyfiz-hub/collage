        function resetZoomFit() {
            const container = document.getElementById('canvas-outer-container');
            const canvas = document.getElementById('collage-canvas');

            const padding = 30;
            const availableW = container.clientWidth - padding;
            const availableH = container.clientHeight - padding;

            if (availableW <= 0 || availableH <= 0) return;

            let targetW = availableW;
            let targetH = targetW / appState.aspectRatioValue;

            if (targetH > availableH) {
                targetH = availableH;
                targetW = targetH * appState.aspectRatioValue;
            }

            canvas.style.width = `${Math.floor(targetW)}px`;
            canvas.style.height = `${Math.floor(targetH)}px`;
            appState.zoomScale = 1.0;
            canvas.style.transform = `scale(${appState.zoomScale})`;
            document.getElementById('zoom-label').innerText = '100%';

            renderCanvas();
        }

        function adjustZoom(delta) {
            appState.zoomScale = Math.max(0.4, Math.min(2.5, appState.zoomScale + delta));
            const canvas = document.getElementById('collage-canvas');
