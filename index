        async function exportCollage(format) {
            showToast("Menjana dokumen... Sila tunggu");
            const canvasEl = document.getElementById('collage-canvas');
            
            // Unselect handles during export
            const savedSelectedId = appState.selectedOverlayId;
            const savedSwapIdx = appState.swapSourceIdx;
            const savedActiveIdx = appState.activeCellIdx;

            appState.selectedOverlayId = null;
            appState.swapSourceIdx = null;
            appState.activeCellIdx = null;
            renderCanvas();

            try {
                const renderedCanvas = await html2canvas(canvasEl, {
                    scale: 3,
                    useCORS: true,
                    allowTaint: true,
                    backgroundColor: appState.bgColor
                });

                if (format === 'pdf') {
                    const { jsPDF } = window.jspdf;
                    const isLandscape = appState.aspectRatioValue > 1;
                    const doc = new jsPDF({
                        orientation: isLandscape ? 'landscape' : 'portrait',
                        unit: 'mm',
                        format: 'a4'
                    });

                    const pdfWidth = doc.internal.pageSize.getWidth();
                    const pdfHeight = doc.internal.pageSize.getHeight();
                    const imgData = renderedCanvas.toDataURL('image/jpeg', 0.95);

                    doc.addImage(imgData, 'JPEG', 0, 0, pdfWidth, pdfHeight);
                    doc.save(`Laporan-Kolaj-${Date.now()}.pdf`);
                    showToast("Dokumen PDF berjaya disimpan!");
                } else {
                    const mimeType = format === 'png' ? 'image/png' : 'image/jpeg';
                    const imgData = renderedCanvas.toDataURL(mimeType, 0.95);
                    const link = document.createElement('a');
                    link.download = `Laporan-Kolaj-${Date.now()}.${format}`;
                    link.href = imgData;
                    link.click();
                    showToast(`Foto ${format.toUpperCase()} berjaya disimpan!`);
                }
            } catch (err) {
                console.error("Ralat mengeksport: ", err);
                showToast("Gagal mengeksport dokumen.");
            } finally {
                appState.selectedOverlayId = savedSelectedId;
                appState.swapSourceIdx = savedSwapIdx;
                appState.activeCellIdx = savedActiveIdx;
                renderCanvas();
            }
        }

