<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CollageStudio Pro - Laporan Bergambar & Layout Canva</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&family=Roboto:wght@400;500;700&family=Oswald:wght@500;700&family=Caveat:wght@700&display=swap" rel="stylesheet">
    <!-- jsPDF for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- html2canvas for High-Res Canvas Rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
            touch-action: manipulation;
        }
        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Poppins', sans-serif;
        }
        
        /* Canvas Outer Area */
        #canvas-outer-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
            background: radial-gradient(circle, #1e293b 10%, #0f172a 90%);
            width: 100%;
            height: 100%;
            padding: 20px;
        }

        #collage-canvas {
            position: relative;
            background-color: #ffffff;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            transition: transform 0.1s ease-out;
            transform-origin: center center;
        }

        /* Custom Scrollbar */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Interactive Grid Items */
        .grid-cell {
            position: absolute;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            user-select: none;
        }
        
        .grid-cell-inner {
            width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px dashed #cbd5e1;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .grid-cell.active .grid-cell-inner {
            border: 2px solid #6366f1 !important;
            box-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
        }
        
        .grid-cell.swap-selected .grid-cell-inner {
            border: 3px solid #f59e0b !important;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
        }

        .grid-cell.drag-over .grid-cell-inner {
            border: 3px solid #10b981 !important;
            background-color: rgba(16, 185, 129, 0.2);
        }

        .grid-cell img {
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: block;
        }

        /* Canvas Overlays */
        .draggable-overlay {
            position: absolute;
            cursor: move;
            touch-action: none;
            border: 2px dashed transparent;
            padding: 4px;
            box-sizing: border-box;
            user-select: none;
            z-index: 20;
        }
        .draggable-overlay.selected {
            border-color: #6366f1;
            background-color: rgba(99, 102, 241, 0.1);
        }

        /* Overlay Control Handles */
        .overlay-handle {
            position: absolute;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: white;
            z-index: 30;
            box-shadow: 0 2px 6px rgba(0,0,0,0.5);
            cursor: pointer;
        }
        .overlay-handle.resize {
            bottom: -12px;
            right: -12px;
            background-color: #6366f1;
            cursor: nwse-resize;
            touch-action: none;
        }
        .overlay-handle.delete {
            top: -12px;
            right: -12px;
            background-color: #ef4444;
        }

        /* Camera Modal Overlay */
        #camera-modal {
            z-index: 100;
        }

        /* Toast Notifications */
        #toast-msg {
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
    </style>
</head>
<body class="flex flex-col h-screen w-screen overflow-hidden select-none bg-slate-950">

    <!-- Toast Alert -->
    <div id="toast-msg" class="fixed top-16 left-1/2 transform -translate-x-1/2 bg-indigo-600 text-white text-xs px-4 py-2 rounded-full shadow-xl opacity-0 pointer-events-none z-50 flex items-center space-x-2">
        <i class="fa-solid fa-circle-info"></i>
        <span id="toast-text">Mesej Notifikasi</span>
    </div>

    <!-- 1. FIXED TOP HEADER BAR -->
    <header class="h-14 bg-slate-900 border-b border-slate-800 flex items-center justify-between px-3 sm:px-6 z-40 shrink-0">
        <!-- Logo & Title -->
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-gradient-to-tr from-indigo-500 to-purple-500 rounded-lg flex items-center justify-center font-bold text-white shadow-lg">
                <i class="fa-solid fa-border-all text-sm"></i>
            </div>
            <span class="font-bold text-base sm:text-lg tracking-wide bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-300">
                CollageStudio <span class="text-xs px-2 py-0.5 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 rounded-full font-sans">Pro</span>
            </span>
        </div>

        <!-- Undo, Redo, Zoom Tools -->
        <div class="flex items-center space-x-1 sm:space-x-2 bg-slate-800/90 p-1 rounded-xl border border-slate-700">
            <button id="btn-undo" onclick="undoAction()" title="Batal (Undo)" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-700 text-slate-300 active:bg-slate-600">
                <i class="fa-solid fa-rotate-left text-sm"></i>
            </button>
            <button id="btn-redo" onclick="redoAction()" title="Semula (Redo)" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-700 text-slate-300 active:bg-slate-600">
                <i class="fa-solid fa-rotate-right text-sm"></i>
            </button>
            <div class="h-4 w-[1px] bg-slate-700 mx-1"></div>
            <button onclick="adjustZoom(-0.1)" title="Zoom Out" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-700 text-slate-300 active:bg-slate-600">
                <i class="fa-solid fa-minus text-xs"></i>
            </button>
            <span id="zoom-label" class="text-xs font-mono px-1 w-10 text-center font-bold text-indigo-400">100%</span>
            <button onclick="adjustZoom(0.1)" title="Zoom In" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-700 text-slate-300 active:bg-slate-600">
                <i class="fa-solid fa-plus text-xs"></i>
            </button>
            <button onclick="resetZoomFit()" title="Reset Auto-Fit" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-700 text-indigo-400 active:bg-slate-600">
                <i class="fa-solid fa-expand text-xs"></i>
            </button>
        </div>

        <!-- Quick Action & Export Button -->
        <div class="flex items-center space-x-2">
            <button onclick="clearCanvasPrompt()" class="text-xs px-2.5 py-1.5 bg-red-500/10 text-red-400 border border-red-500/20 rounded-lg hover:bg-red-500/20">
                <i class="fa-solid fa-trash-can mr-1"></i><span class="hidden sm:inline">Padam Semua</span>
            </button>
            <button onclick="openPanel('export')" class="text-xs sm:text-sm px-3.5 py-1.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold rounded-lg shadow-md flex items-center space-x-1.5">
                <i class="fa-solid fa-download"></i>
                <span>Eksport</span>
            </button>
        </div>
    </header>

    <!-- 2. MAIN PREVIEW CANVAS AREA -->
    <main id="canvas-outer-container">
        <!-- Interactive Canvas Workspace -->
        <div id="collage-canvas">
            <!-- Grid Cells Layer -->
            <div id="grid-layer" class="absolute inset-0 w-full h-full"></div>
            <!-- Overlays Layer (Text & Stickers) -->
            <div id="overlay-layer" class="absolute inset-0 w-full h-full pointer-events-none"></div>
        </div>

        <!-- Floating Info Badge -->
        <div class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur border border-slate-700/60 px-3 py-1.5 rounded-full text-[11px] text-slate-300 flex items-center space-x-2 shadow-lg pointer-events-none z-10">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="canvas-info-badge">Nisbah: A4 Portrait (210x297mm)</span>
        </div>
    </main>

    <!-- 3. SLIDE-UP BOTTOM CONTROL PANELS -->
    <div id="bottom-sheet-panel" class="fixed bottom-16 left-0 right-0 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 p-4 z-30 transition-transform duration-300 transform translate-y-full max-h-[60vh] overflow-y-auto no-scrollbar shadow-2xl">
        <div class="flex items-center justify-between mb-3 border-b border-slate-800 pb-2">
            <h3 id="panel-title" class="font-bold text-xs sm:text-sm text-indigo-400 uppercase tracking-wider flex items-center">
                <i class="fa-solid fa-sliders mr-2"></i> Tetapan
            </h3>
            <button onclick="closePanel()" class="text-slate-400 hover:text-white w-7 h-7 flex items-center justify-center rounded-full hover:bg-slate-800">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <!-- Panel Contents -->
        <div id="panel-contents">
            
            <!-- A. PHOTOS & CAMERA PANEL -->
            <div id="tab-content-photos" class="panel-division hidden space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-indigo-500/40 rounded-xl bg-indigo-500/5 hover:bg-indigo-500/10 cursor-pointer transition-all">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-indigo-400 mb-1"></i>
                        <span class="text-xs font-semibold text-slate-200">Muat Naik Gambar</span>
                        <span class="text-[10px] text-slate-400">JPG, PNG, WEBP (Max 12)</span>
                        <input type="file" id="input-upload-files" multiple accept="image/jpeg,image/png,image/webp" class="hidden" onchange="handleFileUpload(event)">
                    </label>

                    <button onclick="openCameraModal()" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-purple-500/40 rounded-xl bg-purple-500/5 hover:bg-purple-500/10 transition-all">
                        <i class="fa-solid fa-camera text-2xl text-purple-400 mb-1"></i>
                        <span class="text-xs font-semibold text-slate-200">Ambil Foto HD</span>
                        <span class="text-[10px] text-slate-400">Kamera Depan / Belakang</span>
                    </button>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-xs font-medium text-slate-400">Galeri Foto Disimpan (Boleh diseret ke petak):</span>
                        <span id="photo-count-badge" class="text-xs bg-slate-800 px-2 py-0.5 rounded text-indigo-400 font-mono">0 / 12</span>
                    </div>
                    <div id="photo-thumbnails-list" class="flex space-x-2 overflow-x-auto pb-2 no-scrollbar min-h-[75px] bg-slate-950/60 p-2 rounded-xl border border-slate-800">
                        <p class="text-xs text-slate-500 m-auto">Tiada gambar dimuat naik lagi.</p>
                    </div>
                </div>
            </div>

            <!-- B. RATIO & SIZES PANEL -->
            <div id="tab-content-ratio" class="panel-division hidden space-y-3">
                <p class="text-xs text-slate-400">Pilih Nisbah & Format Cetakan / Dokumen:</p>
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
                    <button onclick="setAspectRatio('A4 Portrait', 1/1.414)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-regular fa-file-pdf text-indigo-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">A4 Portrait</span>
                        <span class="text-[9px] text-slate-400">Cetakan Dokumen</span>
                    </button>
                    <button onclick="setAspectRatio('A4 Landscape', 1.414)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-regular fa-file-pdf text-purple-400 text-lg mb-1 rotate-90"></i>
                        <span class="text-xs font-semibold">A4 Landscape</span>
                        <span class="text-[9px] text-slate-400">Laporan Meja</span>
                    </button>
                    <button onclick="setAspectRatio('A3 Poster', 1/1.414)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-solid fa-scroll text-emerald-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">A3 Poster</span>
                        <span class="text-[9px] text-slate-400">Saiz Besar</span>
                    </button>
                    <button onclick="setAspectRatio('16:9 Slide', 16/9)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-solid fa-desktop text-amber-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">16:9 Presentation</span>
                        <span class="text-[9px] text-slate-400">Skrin / Slaid</span>
                    </button>
                    <button onclick="setAspectRatio('4:3 Standard', 4/3)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-solid fa-tv text-pink-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">4:3 Standard</span>
                        <span class="text-[9px] text-slate-400">Galeri TV</span>
                    </button>
                    <button onclick="setAspectRatio('1:1 Segi Empat', 1)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-regular fa-square text-cyan-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">1:1 Square</span>
                        <span class="text-[9px] text-slate-400">Social Media</span>
                    </button>
                    <button onclick="setAspectRatio('3:4 Portrait', 3/4)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-solid fa-mobile-screen text-teal-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">3:4 Potret</span>
                        <span class="text-[9px] text-slate-400">Foto Album</span>
                    </button>
                    <button onclick="setAspectRatio('9:16 Story', 9/16)" class="p-2.5 bg-slate-800 hover:bg-indigo-600/30 border border-slate-700 rounded-xl flex flex-col items-center">
                        <i class="fa-solid fa-mobile text-rose-400 text-lg mb-1"></i>
                        <span class="text-xs font-semibold">9:16 Mobile</span>
                        <span class="text-[9px] text-slate-400">Status / Story</span>
                    </button>
                </div>
            </div>

            <!-- C. LAYOUTS GRID PANEL -->
            <div id="tab-content-layouts" class="panel-division hidden space-y-3">
                <p class="text-xs text-slate-400">Pilih Susunan Grid Laporan (25+ Pilihan Layout Rasmi):</p>
                <div id="layouts-grid-container" class="grid grid-cols-3 sm:grid-cols-6 gap-2 max-h-52 overflow-y-auto pr-1">
                    <!-- Dynamic Layout Presets Injected Here -->
                </div>
            </div>

            <!-- D. EDIT CELL & IMAGE PANEL -->
            <div id="tab-content-editimage" class="panel-division hidden space-y-3">
                <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700 space-y-3">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-2">
                        <span id="edit-cell-label" class="text-xs font-bold text-amber-400">Pilih Petak Untuk Edit Gambar</span>
                        <span class="text-[10px] text-slate-400">Sentuh petak pada kanvas dahulu</span>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-[10px] text-slate-300 block mb-1">Zoom Gambar: <span id="val-img-zoom" class="text-indigo-400">1.0x</span></label>
                            <input type="range" id="slider-img-zoom" min="1.0" max="3.0" step="0.05" value="1.0" oninput="updateActiveImageProp('zoom', parseFloat(this.value))" class="w-full accent-indigo-500">
                        </div>
                        <div>
                            <label class="text-[10px] text-slate-300 block mb-1">Gaya Fit Gambar</label>
                            <select id="select-img-fit" onchange="updateActiveImageProp('fit', this.value)" class="w-full bg-slate-900 text-xs text-white p-1.5 rounded border border-slate-700">
                                <option value="cover">Isi Penuh (Cover)</option>
                                <option value="contain">Muat Penuh (Contain)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-[10px] text-slate-300 block mb-1">Anjak Horisontal (X)</label>
                            <input type="range" id="slider-img-panx" min="-100" max="100" value="0" oninput="updateActiveImageProp('panX', parseInt(this.value))" class="w-full accent-indigo-500">
                        </div>
                        <div>
                            <label class="text-[10px] text-slate-300 block mb-1">Anjak Vertikal (Y)</label>
                            <input type="range" id="slider-img-pany" min="-100" max="100" value="0" oninput="updateActiveImageProp('panY', parseInt(this.value))" class="w-full accent-indigo-500">
                        </div>
                    </div>

                    <div class="flex space-x-2 pt-1 border-t border-slate-700/60">
                        <button onclick="assignPhotoToActiveCell()" class="flex-1 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded text-xs font-semibold">
                            <i class="fa-solid fa-images mr-1"></i> Tukar Foto Petak Ini
                        </button>
                        <button onclick="removeImageFromCell()" class="px-3 py-1.5 bg-red-600/20 hover:bg-red-600/30 text-red-400 border border-red-500/30 rounded text-xs font-semibold">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- E. CAPTIONS PER PHOTO PANEL -->
            <div id="tab-content-captions" class="panel-division hidden space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-slate-300 font-medium">Tetapan Kedudukan Kapsyen Gambar:</span>
                    <div class="flex bg-slate-800 p-1 rounded-lg border border-slate-700 text-xs">
                        <button id="cap-mode-in" onclick="setCaptionMode('inside')" class="px-2.5 py-1 rounded-md font-semibold bg-indigo-600 text-white">Dalam Foto</button>
                        <button id="cap-mode-out" onclick="setCaptionMode('outside')" class="px-2.5 py-1 rounded-md font-semibold text-slate-400">Luar Foto</button>
                    </div>
                </div>

                <div id="caption-inputs-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                    <!-- Injected dynamically based on active layout -->
                </div>
            </div>

            <!-- F. TEXT CANVA EDITOR PANEL -->
            <div id="tab-content-text" class="panel-division hidden space-y-3">
                <div class="flex items-center space-x-2">
                    <button onclick="addNewTextOverlay()" class="flex-1 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold text-xs flex items-center justify-center space-x-1 shadow">
                        <i class="fa-solid fa-plus mr-1"></i>
                        <span>Tambah Teks Tajuk / Catatan</span>
                    </button>
                </div>

                <!-- Live Text Input & Customization -->
                <div class="space-y-3 pt-2 border-t border-slate-800">
                    <div>
                        <label class="text-[10px] text-slate-400 block mb-1">Kandungan Teks Terpilih:</label>
                        <textarea id="text-content-input" rows="2" oninput="updateSelectedTextProp('content', this.value)" placeholder="Pilih atau tambah teks pada kanvas untuk mengedit..." class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg p-2 text-xs focus:outline-none focus:border-indigo-500"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Gaya Fon</label>
                            <select id="text-font-family" onchange="updateSelectedTextProp('fontFamily', this.value)" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg p-2 text-xs">
                                <option value="Montserrat">Montserrat</option>
                                <option value="Poppins">Poppins</option>
                                <option value="Playfair Display">Playfair Display</option>
                                <option value="Oswald">Oswald</option>
                                <option value="Caveat">Caveat (Tulisan Tangan)</option>
                                <option value="Roboto">Roboto</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Saiz Fon (px)</label>
                            <input type="number" id="text-font-size" value="28" min="10" max="120" onchange="updateSelectedTextProp('fontSize', parseInt(this.value))" class="w-full bg-slate-800 border border-slate-700 text-white rounded-lg p-2 text-xs">
                        </div>
                    </div>

                    <div class="flex items-center justify-between space-x-2">
                        <div class="flex items-center space-x-2">
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-1">Teks</label>
                                <input type="color" id="text-color" value="#ffffff" onchange="updateSelectedTextProp('color', this.value)" class="w-9 h-8 bg-slate-800 rounded border border-slate-700 cursor-pointer">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-1">Latar</label>
                                <input type="color" id="text-bg-color" value="#000000" onchange="updateSelectedTextProp('bgColor', this.value)" class="w-9 h-8 bg-slate-800 rounded border border-slate-700 cursor-pointer">
                            </div>
                        </div>
                        <div class="flex items-center space-x-1 pt-3">
                            <button onclick="toggleSelectedTextBold()" class="p-2 bg-slate-800 hover:bg-slate-700 rounded text-xs text-slate-200 border border-slate-700"><i class="fa-solid fa-bold"></i></button>
                            <button onclick="updateSelectedTextProp('align', 'left')" class="p-2 bg-slate-800 hover:bg-slate-700 rounded text-xs text-slate-200 border border-slate-700"><i class="fa-solid fa-align-left"></i></button>
                            <button onclick="updateSelectedTextProp('align', 'center')" class="p-2 bg-slate-800 hover:bg-slate-700 rounded text-xs text-slate-200 border border-slate-700"><i class="fa-solid fa-align-center"></i></button>
