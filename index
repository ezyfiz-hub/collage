        function showToast(text) {
            const toast = document.getElementById('toast-msg');
            document.getElementById('toast-text').innerText = text;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-2');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
                toast.classList.remove('opacity-100', 'translate-y-2');
            }, 2500);
        }

        function openPanel(tabName) {
            document.querySelectorAll('.panel-division').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById(`tab-content-${tabName}`);
            if (target) {
                target.classList.remove('hidden');
                document.getElementById('panel-title').innerText = tabName.toUpperCase();
                document.getElementById('bottom-sheet-panel').classList.remove('translate-y-full');
            }
            if (tabName === 'captions') renderCaptionInputs();
            if (tabName === 'editimage') updateImageEditControls();
            setTimeout(resetZoomFit, 100);
        }

        function closePanel() {
            document.getElementById('bottom-sheet-panel').classList.add('translate-y-full');
            setTimeout(resetZoomFit, 100);
        }

        function renderCanvas() {
            const gridLayer = document.getElementById('grid-layer');
            gridLayer.innerHTML = '';

            const activeLayout = LAYOUT_PRESETS[appState.layoutIndex] || LAYOUT_PRESETS[0];

            activeLayout.boxes.forEach((box, idx) => {
                const cell = document.createElement('div');
                const isSelected = appState.activeCellIdx === idx;
                const isSwap = appState.swapSourceIdx === idx;

                cell.className = `grid-cell ${isSelected ? 'active' : ''} ${isSwap ? 'swap-selected' : ''}`;
                cell.style.left = `${box.x * 100}%`;
                cell.style.top = `${box.y * 100}%`;
                cell.style.width = `${box.w * 100}%`;
                cell.style.height = `${box.h * 100}%`;
                cell.style.padding = `${appState.spacing / 2}px`;

                const innerContainer = document.createElement('div');
                innerContainer.className = 'grid-cell-inner';
                innerContainer.style.borderRadius = `${appState.radius}px`;
                innerContainer.style.backgroundColor = appState.bgColor;

                // Cell Selection & Drag Swap
                cell.onclick = (e) => handleCellClick(idx, e);

                cell.ondragover = (e) => { e.preventDefault(); cell.classList.add('drag-over'); };
                cell.ondragleave = () => cell.classList.remove('drag-over');
                cell.ondrop = (e) => handleDropSwap(e, idx);

                const imgObj = appState.images[idx];
                const imgWrap = document.createElement('div');
                imgWrap.className = 'w-full flex-1 relative overflow-hidden';

                if (imgObj) {
                    const src = typeof imgObj === 'string' ? imgObj : imgObj.url;
                    const zoom = imgObj.zoom || 1.0;
                    const panX = imgObj.panX || 0;
                    const panY = imgObj.panY || 0;
                    const fit = imgObj.fit || 'cover';

                    const img = document.createElement('img');
                    img.src = src;
                    img.style.objectFit = fit;
                    img.style.transform = `scale(${zoom}) translate(${panX}px, ${panY}px)`;
                    img.draggable = true;
                    img.ondragstart = (e) => e.dataTransfer.setData('text/plain', `cell:${idx}`);
                    imgWrap.appendChild(img);
                } else {
                    const placeholder = document.createElement('div');
                    placeholder.className = 'w-full h-full flex flex-col items-center justify-center text-slate-400 bg-slate-100/60';
                    placeholder.innerHTML = `<i class="fa-regular fa-image text-xl mb-1 text-slate-400"></i><span class="text-[10px] text-slate-500 font-medium">Petak ${idx + 1}</span>`;
                    imgWrap.appendChild(placeholder);
                }

                innerContainer.appendChild(imgWrap);

                // Captions rendering
                const capText = appState.captions[idx] || '';
                if (capText) {
                    const capDiv = document.createElement('div');
                    capDiv.innerText = capText;

                    if (appState.captionMode === 'inside') {
