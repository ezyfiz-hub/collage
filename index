        function renderOverlays() {
            const layer = document.getElementById('overlay-layer');
            layer.innerHTML = '';

            appState.overlays.forEach((item) => {
                const isSelected = appState.selectedOverlayId === item.id;
                const el = document.createElement('div');
                el.className = `draggable-overlay ${isSelected ? 'selected' : ''}`;
                el.style.left = `${item.x}px`;
                el.style.top = `${item.y}px`;

                if (item.type === 'text') {
                    el.style.fontFamily = item.fontFamily;
                    el.style.fontSize = `${item.fontSize}px`;
                    el.style.color = item.color;
                    el.style.backgroundColor = item.bgColor || 'transparent';
                    el.style.fontWeight = item.bold ? 'bold' : 'normal';
                    el.style.textAlign = item.align || 'left';
                    el.innerText = item.content;

                    el.ondblclick = (e) => {
                        e.stopPropagation();
                        appState.selectedOverlayId = item.id;
                        openPanel('text');
                        syncTextPanelInputs(item);
                    };
                } else if (item.type === 'sticker') {
                    const img = document.createElement('img');
                    img.src = item.src;
                    img.style.width = `${item.width || 120}px`;
                    img.style.height = 'auto';
                    img.style.pointerEvents = 'none';
                    el.appendChild(img);
                }

                if (isSelected) {
                    const resizer = document.createElement('div');
                    resizer.className = 'overlay-handle resize';
                    resizer.innerHTML = '<i class="fa-solid fa-up-right-and-down-left-from-center"></i>';
                    attachResizeHandler(resizer, item);
                    el.appendChild(resizer);

                    const deleter = document.createElement('div');
                    deleter.className = 'overlay-handle delete';
                    deleter.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    deleter.onclick = (e) => {
                        e.stopPropagation();
                        appState.overlays = appState.overlays.filter(o => o.id !== item.id);
                        appState.selectedOverlayId = null;
                        renderCanvas();
                        saveStateToHistory();
                    };
                    el.appendChild(deleter);
                }

                attachDragHandler(el, item);
                layer.appendChild(el);
            });
        }

        function attachDragHandler(el, item) {
            el.onpointerdown = (e) => {
                if (e.target.classList.contains('overlay-handle')) return;
                e.stopPropagation();

                appState.selectedOverlayId = item.id;
                renderOverlays();

                if (item.type === 'text') {
                    syncTextPanelInputs(item);
                }

                const startX = e.clientX;
                const startY = e.clientY;
                const initX = item.x;
                const initY = item.y;

                const onPointerMove = (evt) => {
                    const dx = evt.clientX - startX;
                    const dy = evt.clientY - startY;
                    item.x = initX + dx;
                    item.y = initY + dy;
                    el.style.left = `${item.x}px`;
                    el.style.top = `${item.y}px`;
                };

                const onPointerUp = () => {
                    window.removeEventListener('pointermove', onPointerMove);
                    window.removeEventListener('pointerup', onPointerUp);
                    saveStateToHistory();
                };

                window.addEventListener('pointermove', onPointerMove);
                window.addEventListener('pointerup', onPointerUp);
            };
        }

        function attachResizeHandler(resizer, item) {
            resizer.onpointerdown = (e) => {
                e.stopPropagation();
                const startX = e.clientX;
                const startW = item.width || 120;
                const startSize = item.fontSize || 28;

                const onPointerMove = (evt) => {
                    const dx = evt.clientX - startX;
                    if (item.type === 'sticker') {
                        item.width = Math.max(30, startW + dx);
                    } else if (item.type === 'text') {
                        item.fontSize = Math.max(10, Math.min(120, startSize + Math.round(dx / 3)));
                        document.getElementById('text-font-size').value = item.fontSize;
                    }
                    renderCanvas();
                };

                const onPointerUp = () => {
                    window.removeEventListener('pointermove', onPointerMove);
                    window.removeEventListener('pointerup', onPointerUp);
                    saveStateToHistory();
                };

                window.addEventListener('pointermove', onPointerMove);
                window.addEventListener('pointerup', onPointerUp);
            };
        }

