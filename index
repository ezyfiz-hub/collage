        function handleCellClick(idx, e) {
            e.stopPropagation();
            if (appState.swapSourceIdx === null) {
                appState.activeCellIdx = idx;
                updateImageEditControls();
            } else if (appState.swapSourceIdx === idx) {
                appState.swapSourceIdx = null;
            } else {
                const targetIdx = idx;
                const srcIdx = appState.swapSourceIdx;

                const temp = appState.images[srcIdx];
                appState.images[srcIdx] = appState.images[targetIdx];
                appState.images[targetIdx] = temp;

                appState.swapSourceIdx = null;
                appState.activeCellIdx = targetIdx;
                saveStateToHistory();
                showToast("Foto berjaya ditukar!");
            }
            renderCanvas();
        }

        function handleDropSwap(e, targetIdx) {
            e.preventDefault();
            const cell = e.currentTarget;
            cell.classList.remove('drag-over');

            const data = e.dataTransfer.getData('text/plain');
            if (data.startsWith('gallery:')) {
                const galleryIdx = parseInt(data.replace('gallery:', ''));
                if (!isNaN(galleryIdx) && appState.images[galleryIdx]) {
                    appState.images[targetIdx] = { ...appState.images[galleryIdx] };
                    appState.activeCellIdx = targetIdx;
                    saveStateToHistory();
                    renderCanvas();
                    showToast(`Foto diletakkan di Petak ${targetIdx + 1}`);
                }
            } else if (data.startsWith('cell:')) {
                const sourceIdx = parseInt(data.replace('cell:', ''));
                if (!isNaN(sourceIdx) && sourceIdx !== targetIdx) {
                    const temp = appState.images[sourceIdx];
                    appState.images[sourceIdx] = appState.images[targetIdx];
                    appState.images[targetIdx] = temp;
                    appState.activeCellIdx = targetIdx;
                    saveStateToHistory();
                    renderCanvas();
                    showToast("Kedudukan foto ditukar");
                }
            }
        }

